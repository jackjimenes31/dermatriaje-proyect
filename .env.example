# Copia este archivo a .env y ajusta los valores para tu entorno local.

SECRET_KEY=django-insecure-change-me-in-local-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite por defecto. Para apuntar a Postgres en despliegue:
# DATABASE_URL=postgres://usuario:password@host:5432/nombre_bd
DATABASE_URL=sqlite:///db.sqlite3

# Orígenes permitidos para que la PWA (dev server) consuma la API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
